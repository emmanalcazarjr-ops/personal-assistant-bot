# Required
BOT_TOKEN=123456789:AA...your-telegram-bot-token
WEBHOOK_SECRET=change-me-long-random-string
CRON_SECRET=change-me-another-long-random-string

# Obsidian vault backend (private repo)
# Fine-grained PAT with Contents read/write on obsidian-vault only:
#   https://github.com/settings/personal-access-tokens/new
VAULT_PAT=github_pat_...
VAULT_OWNER=emmanalcazarjr-ops
VAULT_REPO=obsidian-vault

# DeepSeek AI brain (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# Your Telegram chat id (used by the daily briefing when set; find with /id)
OWNER_CHAT_ID=

# Local webhook (only used by `npm run set-webhook`)
WEBHOOK_URL=

# Optional: briefing weather location (defaults to Manila, PH)
WEATHER_CITY=Manila
WEATHER_LAT=14.5995
WEATHER_LON=120.9842
TIMEZONE=Asia/Manila
